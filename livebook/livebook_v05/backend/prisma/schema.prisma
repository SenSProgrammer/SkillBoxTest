// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // если решите запускаться на SQLite временно, замените на "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  role      Role      @default(READER)
  createdAt DateTime  @default(now())
  comments  Comment[]
}

enum Role {
  READER
  CONTRIBUTOR
  EDITOR
  ADMIN
}

model Book {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  createdAt DateTime @default(now())
  theses    Thesis[]
}

model Thesis {
  id          String        @id @default(uuid())
  bookId      String
  book        Book          @relation(fields: [bookId], references: [id])

  // Иерархия тезисов (для дерева)
  parentId    String?
  parent      Thesis?       @relation("ThesisToParent", fields: [parentId], references: [id])
  children    Thesis[]      @relation("ThesisToParent")

  slug        String        @unique
  version     Int           @default(1)
  language    String
  confession  String?
  textMd      String?
  textHtml    String?
  status      Status        @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations Translation[]
  comments     Comment[]
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Translation {
  id         String   @id @default(uuid())
  thesisId   String
  thesis     Thesis   @relation(fields: [thesisId], references: [id])

  language   String
  confession String?
  textMd     String?
  textHtml   String?
  origin     Origin   @default(AI)

  @@unique([thesisId, language, confession])
}

enum Origin {
  HUMAN
  AI
}

model Comment {
  id                String      @id @default(uuid())
  thesisId          String
  thesis            Thesis      @relation(fields: [thesisId], references: [id])
  authorId          String
  author            User        @relation(fields: [authorId], references: [id])
  textMd            String
  moderationStatus  Moderation  @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

enum Moderation {
  PENDING
  APPROVED
  REJECTED
}
